# --- OpenRouter ---
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Servidor ---
# DEBUG=true só em desenvolvimento (não use em produção!)
DEBUG=false
# LOG_LEVEL=DEBUG mostra cache hits e detalhes; INFO é o padrão
LOG_LEVEL=INFO
# PORT padrão 5001 (5000 conflita com AirPlay no macOS)
PORT=5001
