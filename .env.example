# --- Backends de IA ---
# Backend principal: "ollama" (local) ou "openrouter" (nuvem).
BACKEND_PRIMARY=ollama
# Fallback usado quando o primário falha. Deixe vazio para desabilitar.
BACKEND_FALLBACK=openrouter

# --- Ollama (local) ---
# Suba com: `ollama serve` e baixe o modelo: `ollama pull gemma3:12b`
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:12b

# --- OpenRouter (nuvem) ---
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_MODEL=google/gemini-2.5-flash
