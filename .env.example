# --- Backends de IA ---
# Backend principal: "local" (Ollama, LM Studio, etc.) ou "openrouter" (nuvem).
BACKEND_PRIMARY=local
# Fallback usado quando o primário falha. Deixe vazio para desabilitar.
BACKEND_FALLBACK=openrouter

# --- LLM local (Ollama, LM Studio, ...) ---
# Ollama:    URL=http://localhost:11434/v1   MODEL=gemma3:12b
# LM Studio: URL=http://localhost:1234/v1    MODEL=<id mostrado na aba Developer>
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma3:12b

# --- OpenRouter (nuvem) ---
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_MODEL=google/gemini-2.5-flash
